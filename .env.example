# ===== PostgreSQL (хранилище опубликованной страницы: таблица page_content) =====
# ONREZA Managed PostgreSQL — задай DATABASE_URL в Project → Settings → Environment Variables.
# Если в URL нет параметра SSL, а managed PG требует TLS — добавь ?sslmode=require в конец.
DATABASE_URL=

# ===== Cloudflare Workers AI (production AI, fallback) =====
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== Admin (пароль публикации PUT /api/page; пусто = открыт, режим MVP) =====
ADMIN_TOKEN=
