# ===== KV / Redis (хранение страниц и лидов) =====
# Upstash REST API (Upstash Redis, Vercel KV) — работает на любой платформе (ONREZA и т.д.),
# код ходит по REST напрямую (fetch), без SDK. Бесплатная БД: https://console.upstash.com
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Telegram Webhook (notifications) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Cloudflare Workers AI (production AI, fallback) =====
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ===== Admin (пароль публикации PUT /api/page; пусто = открыт, режим MVP) =====
ADMIN_TOKEN=
